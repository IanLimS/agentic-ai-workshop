{
  "openapi": "3.0.3",
  "info": {
    "title": "S3 Presign Helper",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://YOUR_HOST"
    }
  ],
  "paths": {
    "/s3/presign": {
      "post": {
        "summary": "Create a presigned URL for S3 upload/download",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bucket": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "get_object",
                      "put_object"
                    ]
                  },
                  "expires_in": {
                    "type": "integer",
                    "default": 900
                  }
                },
                "required": [
                  "bucket",
                  "key",
                  "operation"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/s3/list_objects": {
      "post": {
        "summary": "List objects in a bucket/prefix",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bucket": {
                    "type": "string"
                  },
                  "prefix": {
                    "type": "string"
                  }
                },
                "required": [
                  "bucket"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of objects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "objects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "size": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}